# Image and internal service routing
MTC_IMAGE=vuteq/mtc-app:production
API_URL=http://api:31000

# External PostgreSQL database
DATABASE_URL=CHANGE_ME

# Vuteq SSO
VUTEQ_SSO_ENABLED=true
VUTEQ_SSO_BASE_URL=https://sso.vuteq.co.id
VUTEQ_SSO_SECRET=CHANGE_ME
VUTEQ_SSO_ALLOWED_CLIENT_IDS=mtc-web
# Origin only. Register callback/logout/back-channel URLs under /mtc as documented.
VUTEQ_SSO_PUBLIC_ORIGIN=https://apps3.vuteq.co.id
VUTEQ_SSO_TRUST_PROXY=true

# Redis-backed server-side SSO sessions
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
VUTEQ_SSO_REDIS_DB=0
VUTEQ_SSO_REDIS_KEY_PREFIX=production:

# Application access and operations
BOOTSTRAP_ADMIN_EMAIL=
MTC_DISPLAY_API_KEY=CHANGE_ME
SWAGGER_ENABLED=false
SWAGGER_API_KEY=
HEALTH_READINESS_PROTECTED=false
HEALTH_READINESS_TOKEN=
